{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esntls-site-edge",
  "main": "worker/site-cdn-worker.js",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "esntls-images"
    }
  ],
  // Member accounts and member pricing for ESNTLS STOCKROOM. These must not
  // live in the repo: the site is served from a public GitHub origin.
  // Create with `wrangler d1 create esntls-stockroom`, then paste the id here.
  "d1_databases": [
    {
      "binding": "STOCKROOM_DB",
      "database_name": "esntls-stockroom",
      "database_id": "PASTE_DATABASE_ID_FROM_WRANGLER_D1_CREATE"
    }
  ],
  "routes": [
    {
      "pattern": "esntlsclub.com/*",
      "zone_name": "esntlsclub.com"
    },
    {
      "pattern": "www.esntlsclub.com/*",
      "zone_name": "esntlsclub.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
